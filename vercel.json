{
  "version": 2,
  "name": "juridico-caldas-brito",
  "rewrites": [
    {
      "source": "/js/env.js",
      "destination": "/backend/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/backend/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "crons": []
}

